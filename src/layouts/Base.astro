---
import '../styles/global.css';
import { SITE_TITLE, ADSENSE_CLIENT, GA_MEASUREMENT_ID, CONTACT_EMAIL } from '../consts';
import { UI, prefix, DEFAULT_LANG, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  jsonLd?: Record<string, unknown>;
  // 이 페이지의 언어별 주소. 언어 전환 링크와 hreflang에 쓰입니다.
  alternates?: { lang: Lang; href: string }[];
}

const { lang = DEFAULT_LANG, title, type = 'website', jsonLd, alternates = [], image } = Astro.props;
const imageUrl = image ? new URL(image, Astro.site).toString() : undefined;
const t = UI[lang];
const description = Astro.props.description ?? t.siteDescription;
const fullTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const p = prefix(lang);
const otherLang: Lang = lang === 'ko' ? 'en' : 'ko';
const switchHref = alternates.find((a) => a.lang === otherLang)?.href ?? `${prefix(otherLang)}/`;
const xDefault = alternates.find((a) => a.lang === DEFAULT_LANG);
// 형식이 맞는 ID만 태그에 넣습니다 (오타로 스크립트가 깨지지 않게).
const gaId = /^G-[A-Z0-9]+$/.test(GA_MEASUREMENT_ID) ? GA_MEASUREMENT_ID : '';

const nav = [
  { href: `${p}/`, label: t.blog, active: path === `${p}/` || path.startsWith(`${p}/blog`) },
  { href: '/apps/', label: t.apps, active: path.startsWith('/apps') },
  { href: `${p}/about/`, label: t.about, active: path.startsWith(`${p}/about`) },
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => (
    <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site)} />
  ))}
  {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault.href, Astro.site)} />}
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={`${p}/rss.xml`} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE_TITLE} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={t.ogLocale} />
  {imageUrl && <meta property="og:image" content={imageUrl} />}
  <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
  {imageUrl && <meta name="twitter:image" content={imageUrl} />}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  {gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
  {gaId && (
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', gaId);
    </script>
  )}
  {ADSENSE_CLIENT && (
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
      crossorigin="anonymous"
    ></script>
  )}
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a class="logo" href={`${p}/`}>{SITE_TITLE}</a>
      <nav class="nav">
        {nav.map((item) => (
          <a href={item.href} class:list={[{ active: item.active }]}>{item.label}</a>
        ))}
        <a href={switchHref} hreflang={otherLang} class="lang-switch">{t.switchTo}</a>
      </nav>
    </div>
  </header>
  <main class="container">
    <slot />
  </main>
  <footer class="site-footer">
    <span>© {new Date().getFullYear()} {SITE_TITLE}</span>
    <a href={`${p}/privacy/`}>{t.privacy}</a>
    <a href={`mailto:${CONTACT_EMAIL}`}>{t.contact}</a>
    <a href={`${p}/rss.xml`}>RSS</a>
  </footer>
</body>
</html>
