---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base
  jsonLd={{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_TITLE, url: SITE_URL, description: SITE_DESCRIPTION }}
>
  <h1 class="page-title">블로그</h1>
  <p class="page-sub">{SITE_DESCRIPTION}</p>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="post-card" href={`/blog/${post.id}/`}>
          <div class="meta">
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          </div>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
</Base>
